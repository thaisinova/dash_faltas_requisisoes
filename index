      } else {
        if(typeof XLSX === 'undefined') throw new Error('Para abrir arquivos Excel é necessário acesso à internet. Salve a planilha como CSV e carregue novamente.');
        const wb = XLSX.read(e.target.result,{type:'array',cellDates:true,raw:false});
        const ws = wb.Sheets['Registro'] || wb.Sheets[wb.SheetNames[0]];
        brutos = XLSX.utils.sheet_to_json(ws,{defval:'',raw:false});
      }
      aplicarBase(brutos, arq.name);
    }catch(err){
      mostrarAviso('erro','Erro ao carregar: ' + err.message);
    }
  };
  leitor.readAsArrayBuffer(arq);
  ev.target.value = '';
});
function restaurarBase(){
  BASE = preparar(BASE_ORIGINAL);
  $('nomeFonte').textContent = 'dados incorporados';
  $('dataCarga').textContent = '';
  iniciarFiltros();
  mostrarAviso('ok','Base original restaurada: ' + num(BASE.length) + ' registros.');
}

/* ===================== FILTROS ===================== */
function iniciarFiltros(){
  const datas = BASE.map(r=>r.dt).filter(Boolean).sort((a,b)=>a-b);
  $('di').value = datas.length ? iso(datas[0]) : '';
  $('df').value = datas.length ? iso(datas[datas.length-1]) : '';
  preencher('tipo','t','Todos'); preencher('linha','l','Todas');
  ['cod','op','busca'].forEach(id=>$(id).value='');
  $('qtdFonte').textContent = num(BASE.length);
  aplicar();
}
function preencher(id, campo, rotulo){
  const vals=[...new Set(BASE.map(r=>r[campo]).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'pt-BR',{numeric:true}));
  $(id).innerHTML = '<option value="">'+rotulo+'</option>' + vals.map(v=>'<option value="'+esc(v)+'">'+esc(v)+'</option>').join('');
}
['di','df','tipo','linha','cod','op','busca'].forEach(id=>{
  $(id).addEventListener(['cod','op','busca'].includes(id)?'input':'change', aplicar);
});
$('incluirInvalidos').addEventListener('change', render);
function aplicar(){
  const ini = $('di').value ? new Date($('di').value+'T00:00:00') : null;
  const fim = $('df').value ? new Date($('df').value+'T23:59:59') : null;
  const tipo = $('tipo').value, linha = $('linha').value;
  const cod = semAcento($('cod').value.trim()), op = semAcento($('op').value.trim()), q = semAcento($('busca').value.trim());
  FILTRADO = BASE.filter(r=>
    (!ini || !r.dt || r.dt >= ini) && (!fim || !r.dt || r.dt <= fim) &&
    (!tipo || r.t === tipo) && (!linha || r.l === linha) &&
    (!cod || semAcento(r.c).includes(cod)) && (!op || semAcento(r.op).includes(op)) &&
    (!q || semAcento([r.op,r.c,r.t,r.l,r.o,r.s].join(' ')).includes(q))
  );
  render();
}
function limparFiltros(){ $('incluirInvalidos').checked = false; iniciarFiltros(); }

/* ===================== AGREGAÇÕES ===================== */
function contar(lista, chave){
  const o = {};
  lista.forEach(r=>{ const v = typeof chave==='function'?chave(r):r[chave]; if(v!==''&&v!=null) o[v]=(o[v]||0)+1; });
  return o;
}
function somar(lista, chave, valor){
  const o = {};
  lista.forEach(r=>{ const v=r[chave]; if(v && r[valor]!=null) o[v]=(o[v]||0)+r[valor]; });
  return o;
}
const ordenarDesc = o => Object.entries(o).sort((a,b)=>b[1]-a[1]);
function getTopKey(o){ const e = ordenarDesc(o)[0]; return e ? e[0] : '—'; }

/* ===================== GRÁFICOS (SVG) ===================== */
function semDados(id, msg){ $(id).innerHTML = '<div class="vazio">'+(msg||'Sem dados para o filtro selecionado.')+'</div>'; }

function barrasEmpilhadas(id, chaves, series, rotulo){
  if(!chaves.length) return semDados(id);
  const L=52,R=16,T=18,B=34,H=250,W=Math.max(640, chaves.length*54);
  const alt=H-T-B;
  const totais = chaves.map(k => series.reduce((s,se)=>s+(se.dados[k]||0),0));
  const max = Math.max(1, ...totais);
  const passo = (W-L-R)/chaves.length, larg = Math.min(38, passo*0.62);
  let g='';
  for(let i=0;i<=4;i++){
    const v=max*i/4, y=T+alt-(alt*i/4);
    g+='<line x1="'+L+'" y1="'+y+'" x2="'+(W-R)+'" y2="'+y+'" stroke="#eef3f7"/>'
      +'<text x="'+(L-8)+'" y="'+(y+4)+'" text-anchor="end" font-size="10" fill="#8a9aa8">'+num(Math.round(v))+'</text>';
  }
  chaves.forEach((k,i)=>{
    const x=L+passo*i+(passo-larg)/2; let acum=0;
    series.forEach(se=>{
      const v=se.dados[k]||0; if(!v) return;
      const h=alt*v/max, y=T+alt-h-acum;
      g+='<rect class="barra" x="'+x+'" y="'+y+'" width="'+larg+'" height="'+h+'" fill="'+se.cor+'"><title>'+esc(rotulo(k))+' · '+esc(se.nome)+': '+num(v)+'</title></rect>';
      acum+=h;
    });
    g+='<text x="'+(x+larg/2)+'" y="'+(T+alt-acum-6)+'" text-anchor="middle" font-size="10" font-weight="bold" fill="#43586a">'+num(totais[i])+'</text>'
      +'<text x="'+(x+larg/2)+'" y="'+(H-14)+'" text-anchor="middle" font-size="10.5" fill="#63788a">'+esc(rotulo(k))+'</text>';
  });
  g+='<line x1="'+L+'" y1="'+(T+alt)+'" x2="'+(W-R)+'" y2="'+(T+alt)+'" stroke="#cfdae3"/>';
  $(id).innerHTML='<div style="overflow-x:auto"><svg viewBox="0 0 '+W+' '+H+'" style="min-width:'+W+'px;height:'+H+'px">'+g+'</svg></div>';
}

function rosca(id, pares){
  const total = pares.reduce((s,p)=>s+p[1],0);
  if(!total) return semDados(id);
  const cx=115, cy=125, rE=92, rI=56;
  let ang=-Math.PI/2, fatias='';
  pares.forEach(([nome,val])=>{
    const a=2*Math.PI*val/total, fim=ang+a, grande=a>Math.PI?1:0;
    const p=(r,t)=>[cx+r*Math.cos(t), cy+r*Math.sin(t)];
    const [x1,y1]=p(rE,ang), [x2,y2]=p(rE,fim), [x3,y3]=p(rI,fim), [x4,y4]=p(rI,ang);
    fatias+='<path class="barra" d="M'+x1+' '+y1+' A'+rE+' '+rE+' 0 '+grande+' 1 '+x2+' '+y2+' L'+x3+' '+y3+' A'+rI+' '+rI+' 0 '+grande+' 0 '+x4+' '+y4+' Z" fill="'+(CORES[nome]||CORES.Outros)+'"><title>'+esc(nome)+': '+num(val)+' ('+(val/total*100).toFixed(1)+'%)</title></path>';
    const [mx,my]=p((rE+rI)/2,(ang+fim)/2);
    if(val/total>0.06) fatias+='<text x="'+mx+'" y="'+(my+4)+'" text-anchor="middle" font-size="12" font-weight="bold" fill="#fff">'+(val/total*100).toFixed(0)+'%</text>';
    ang=fim;
  });
  let leg=''; pares.forEach(([nome,val],i)=>{
    const y=58+i*32;
    leg+='<rect x="250" y="'+(y-11)+'" width="13" height="13" rx="3" fill="'+(CORES[nome]||CORES.Outros)+'"/>'
       +'<text x="272" y="'+y+'" font-size="12.5" fill="#1d2b36">'+esc(nome)+'</text>'
       +'<text x="272" y="'+(y+15)+'" font-size="11.5" fill="#63788a">'+num(val)+' · '+(val/total*100).toFixed(1)+'%</text>';
  });
  $(id).innerHTML='<svg viewBox="0 0 430 250" style="height:250px">'+fatias
    +'<text x="'+cx+'" y="'+(cy-4)+'" text-anchor="middle" font-size="20" font-weight="bold" fill="#0f3557">'+num(total)+'</text>'
    +'<text x="'+cx+'" y="'+(cy+16)+'" text-anchor="middle" font-size="11" fill="#63788a">registros</text>'+leg+'</svg>';
}

function barrasH(id, pares, cor, sufixo){
  if(!pares.length) return semDados(id);
  const L=96,R=54,T=8,linhaAlt=27,H=T+pares.length*linhaAlt+8,W=640;
  const max=Math.max(...pares.map(p=>p[1]));
  let g='';
  pares.forEach(([nome,val],i)=>{
    const y=T+i*linhaAlt, larg=(W-L-R)*val/max;
    g+='<text x="'+(L-10)+'" y="'+(y+16)+'" text-anchor="end" font-size="11.5" fill="#43586a">'+esc(nome)+'</text>'
      +'<rect x="'+L+'" y="'+(y+3)+'" width="'+(W-L-R)+'" height="18" rx="4" fill="#f2f6f9"/>'
      +'<rect class="barra" x="'+L+'" y="'+(y+3)+'" width="'+larg+'" height="18" rx="4" fill="'+cor+'"><title>'+esc(nome)+': '+dec(val)+'</title></rect>'
      +'<text x="'+(L+larg+8)+'" y="'+(y+17)+'" font-size="11.5" font-weight="bold" fill="#43586a">'+dec(val)+(sufixo||'')+'</text>';
  });
  $(id).innerHTML='<svg viewBox="0 0 '+W+' '+H+'" style="height:'+Math.max(H,120)+'px">'+g+'</svg>';
}

function pareto(id, pares){
  if(!pares.length) return semDados(id);
  const L=52,R=48,T=20,B=42,H=290,W=Math.max(680,pares.length*44);
  const alt=H-T-B, max=Math.max(...pares.map(p=>p[1]));
  const total=pares.reduce((s,p)=>s+p[1],0);
  const passo=(W-L-R)/pares.length, larg=Math.min(26,passo*0.58);
  let g='',pts=[],acum=0;
  for(let i=0;i<=4;i++){
    const y=T+alt-(alt*i/4);
    g+='<line x1="'+L+'" y1="'+y+'" x2="'+(W-R)+'" y2="'+y+'" stroke="#eef3f7"/>'
      +'<text x="'+(L-8)+'" y="'+(y+4)+'" text-anchor="end" font-size="10" fill="#8a9aa8">'+num(Math.round(max*i/4))+'</text>'
      +'<text x="'+(W-R+8)+'" y="'+(y+4)+'" font-size="10" fill="#c0392b">'+(25*i)+'%</text>';
  }
  pares.forEach(([nome,val],i)=>{
    const x=L+passo*i+(passo-larg)/2, h=alt*val/max, y=T+alt-h;
    acum+=val; const pct=acum/total*100;
    pts.push([L+passo*i+passo/2, T+alt-alt*pct/100]);
    g+='<rect class="barra" x="'+x+'" y="'+y+'" width="'+larg+'" height="'+h+'" rx="3" fill="#1b6fa8"><title>'+esc(nome)+': '+num(val)+' · acumulado '+pct.toFixed(1)+'%</title></rect>'
      +'<text x="'+(x+larg/2)+'" y="'+(y-5)+'" text-anchor="middle" font-size="9.5" fill="#43586a">'+num(val)+'</text>'
      +'<text x="'+(x+larg/2)+'" y="'+(H-20)+'" text-anchor="middle" font-size="10" fill="#63788a" transform="rotate(-42 '+(x+larg/2)+' '+(H-20)+')">'+esc(nome)+'</text>';
  });
  g+='<polyline points="'+pts.map(p=>p[0]+','+p[1]).join(' ')+'" fill="none" stroke="#c0392b" stroke-width="2.4"/>';
  pts.forEach(p=>g+='<circle cx="'+p[0]+'" cy="'+p[1]+'" r="3.4" fill="#fff" stroke="#c0392b" stroke-width="2"/>');
  g+='<line x1="'+L+'" y1="'+(T+alt)+'" x2="'+(W-R)+'" y2="'+(T+alt)+'" stroke="#cfdae3"/>';
  $(id).innerHTML='<div style="overflow-x:auto"><svg viewBox="0 0 '+W+' '+H+'" style="min-width:'+W+'px;height:'+H+'px">'+g+'</svg></div>';
}

/* ===================== RENDER ===================== */
function render(){
  const tipos = contar(FILTRADO,'t');
  const linhas = contar(FILTRADO,'l');
  const total = FILTRADO.length || 0;

  /* Base para análise por código: descarta registros com código fora do padrão,
     salvo se o usuário optar por incluí-los. */
  const incluirInv = $('incluirInvalidos').checked;
  const invalidos = FILTRADO.filter(r => r.c && !codigoValido(r.c));
  const porCodigo = incluirInv ? FILTRADO : FILTRADO.filter(r => !r.c || codigoValido(r.c));
  const codigos = contar(porCodigo,'c');
  const pct = v => total ? ' · ' + (v/total*100).toFixed(1) + '% do total' : '';

  $('kTotal').textContent = num(total);
  $('kTotalSub').textContent = num(BASE.length) + ' registros na base';
  $('kFalta').textContent = num(tipos['Falta']||0);
  $('kFaltaSub').textContent = (tipos['Falta']?pct(tipos['Falta']):'—').replace(' · ','');
  $('kReq').textContent = num(tipos['Requisição']||0);
  $('kReqSub').textContent = (tipos['Requisição']?pct(tipos['Requisição']):'—').replace(' · ','');
  $('kSobra').textContent = num(tipos['Sobras']||0);
  $('kSobraSub').textContent = (tipos['Sobras']?pct(tipos['Sobras']):'—').replace(' · ','');
  const somaQtd = porCodigo.reduce((s,r)=>s+(r.q||0),0);
  const comQtd = porCodigo.filter(r=>r.q!=null).length;
  $('kQtd').textContent = dec(somaQtd);
  $('kQtdSub').textContent = num(comQtd)+' registros com quantidade';
  const topCod = getTopKey(codigos);
  $('kCod').textContent = topCod;
  $('kCodSub').textContent = codigos[topCod] ? num(codigos[topCod])+' ocorrências' : '—';
  const topLinha = getTopKey(linhas);
  $('kLinha').textContent = topLinha;
  $('kLinhaSub').textContent = linhas[topLinha] ? num(linhas[topLinha])+' ocorrências' : '—';

  const datas = FILTRADO.map(r=>r.dt).filter(Boolean).sort((a,b)=>a-b);
  $('periodo').textContent = datas.length ? dataBR(datas[0])+' a '+dataBR(datas[datas.length-1]) : 'sem registros';

  /* Médias: o denominador acompanha o período realmente filtrado. */
  const qtdMeses = new Set(FILTRADO.filter(r=>r.mes).map(r=>r.mes)).size;
  const qtdDias = datas.length ? diasUteis(datas[0], datas[datas.length-1]) : 0;
  $('kMes').textContent = qtdMeses ? dec(total/qtdMeses) : '—';
  $('kMesSub').textContent = qtdMeses ? 'em '+num(qtdMeses)+(qtdMeses===1?' mês com registro':' meses com registro') : 'sem datas no filtro';
  $('kDia').textContent = qtdDias ? dec(total/qtdDias) : '—';
  $('kDiaSub').textContent = qtdDias ? 'em '+num(qtdDias)+' dias úteis no período' : 'sem datas no filtro';

  const meses = [...new Set(FILTRADO.filter(r=>r.mes).map(r=>r.mes))].sort();
  barrasEmpilhadas('gEvolucao', meses, [
    {nome:'Falta', cor:CORES['Falta'], dados:contar(FILTRADO.filter(r=>r.t==='Falta'),'mes')},
    {nome:'Requisição', cor:CORES['Requisição'], dados:contar(FILTRADO.filter(r=>r.t==='Requisição'),'mes')},
    {nome:'Sobras', cor:CORES['Sobras'], dados:contar(FILTRADO.filter(r=>r.t==='Sobras'),'mes')}
  ], mesRotulo);

  rosca('gTipo', ordenarDesc(tipos));
  barrasH('gLinha', ordenarDesc(linhas).slice(0,12), '#1b6fa8');
  pareto('gPareto', ordenarDesc(codigos).slice(0,20));
  barrasH('gQtd', ordenarDesc(somar(porCodigo,'c','q')).slice(0,15), '#1f7a5c');

  /* Transparência: informa o que ficou de fora. */
  const nota = invalidos.length
    ? (incluirInv
        ? ' Atenção: '+num(invalidos.length)+' registro(s) com código fora do padrão estão incluídos e podem distorcer os valores.'
        : ' '+num(invalidos.length)+' registro(s) com código fora do padrão foram desconsiderados.')
    : '';
  $('hintPareto').textContent = '20 códigos com mais lançamentos e o percentual acumulado, para priorizar as ações.' + nota;
  $('hintQtd').textContent = '15 códigos com maior soma de quantidade solicitada.' + nota;
  $('infoInvalidos').innerHTML = invalidos.length
    ? '<span class="alerta">'+num(invalidos.length)+' registro(s) com código fora do padrão</span> códigos válidos têm 4 ou 5 dígitos; os demais costumam ser código e quantidade trocados no formulário'
    : 'Nenhum código fora do padrão no filtro atual.';

  const nomesDias=['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'];
  const porDia = contar(FILTRADO.filter(r=>r.dia!=null), r=>nomesDias[r.dia]);
  barrasH('gSemana', nomesDias.filter(d=>porDia[d]).map(d=>[d,porDia[d]]), '#e08e0b');

  tabela();
}

/* ===================== TABELA ===================== */
document.querySelectorAll('thead th').forEach(th=>{
  th.style.cursor='pointer';
  th.addEventListener('click',()=>{
    const col = th.dataset.col;
    ordem = {col, asc: ordem.col===col ? !ordem.asc : false};
    tabela();
  });
});
function tabela(){
  const {col, asc} = ordem;
  const linhas = FILTRADO.slice().sort((a,b)=>{
    let x=a[col], y=b[col];
    if(col==='dt'){ x=x?x.getTime():0; y=y?y.getTime():0; }
    else if(col==='q'){ x=x==null?-1:x; y=y==null?-1:y; }
    else { x=semAcento(x); y=semAcento(y); }
    if(x<y) return asc?-1:1;
    if(x>y) return asc?1:-1;
    return 0;
  }).slice(0,500);
  $('tbody').innerHTML = linhas.map(r=>{
    const classe = 't-'+semAcento(r.t).replace(/[^a-z]/g,'');
    return '<tr><td>'+esc(r.d)+'</td><td>'+esc(r.op)+'</td><td>'+esc(r.c)+'</td><td>'+(r.q==null?'—':dec(r.q))
      +'</td><td><span class="tag '+(['t-falta','t-requisicao','t-sobras'].includes(classe)?classe:'t-outros')+'">'+esc(r.t)+'</span></td><td>'+esc(r.l)
      +'</td><td title="'+esc(r.o)+'">'+esc(r.o||'—')+'</td><td>'+esc(r.s||'—')+'</td></tr>';
  }).join('') || '<tr><td colspan="8" style="text-align:center;padding:26px;color:#63788a">Nenhum registro encontrado com os filtros aplicados.</td></tr>';
  $('infoTabela').textContent = FILTRADO.length>500
    ? 'Exibindo 500 de '+num(FILTRADO.length)+' registros filtrados.'
    : num(FILTRADO.length)+' registro(s) filtrado(s).';
}

/* ===================== EXPORTAÇÃO ===================== */
function exportarCSV(){
  if(!FILTRADO.length){ mostrarAviso('erro','Não há registros filtrados para exportar.'); return; }
  const cab=['Data','Ordem de Produção','Código','Quantidade','Tipo','Linha','Observação','Status'];
  const linhas=FILTRADO.map(r=>[r.d,r.op,r.c,(r.q==null?'':String(r.q).replace('.',',')),r.t,r.l,r.o,r.s]);
  const csv=[cab,...linhas].map(l=>l.map(v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"').join(';')).join('\n');
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8;'}));
  a.download='faltas_requisicoes_filtrado.csv';
  document.body.appendChild(a); a.click(); a.remove();
}

/* ===================== INÍCIO ===================== */
window.addEventListener('error', e=>{ mostrarAviso('erro','Erro no dashboard: '+e.message); });
BASE = preparar(BASE_ORIGINAL);
iniciarFiltros();
</script>
