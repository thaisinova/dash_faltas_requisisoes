const num = n => Number(n||0).toLocaleString('pt-BR');
const dec = n => Number(n||0).toLocaleString('pt-BR',{maximumFractionDigits:1});
const semAcento = t => String(t==null?'':t).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const esc = t => String(t==null?'':t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

/* ===================== DATAS ===================== */
function paraData(txt){
  if(txt instanceof Date && !isNaN(txt)) return txt;
  const s = String(txt||'').trim();
  if(!s) return null;
  let m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?/);
  if(m) return new Date(+m[3], +m[2]-1, +m[1], +(m[4]||0), +(m[5]||0), +(m[6]||0));
  m = s.match(/^(\d{4})-(\d{2})-(\d{2})(?:[ T](\d{1,2}):(\d{2}))?/);
  if(m) return new Date(+m[1], +m[2]-1, +m[3], +(m[4]||0), +(m[5]||0));
  const d = new Date(s);
  return isNaN(d) ? null : d;
}
const iso = d => d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const mesChave = d => d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
const MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
const mesRotulo = k => { const [a,m]=k.split('-'); return MESES[+m-1]+'/'+a.slice(2); };
const dataBR = d => d ? d.toLocaleDateString('pt-BR') : '';
function diasUteis(ini, fim){
  if(!ini || !fim) return 0;
  let n = 0;
  const d = new Date(ini.getFullYear(), ini.getMonth(), ini.getDate());
  const f = new Date(fim.getFullYear(), fim.getMonth(), fim.getDate());
  while(d <= f){ const s = d.getDay(); if(s >= 1 && s <= 5) n++; d.setDate(d.getDate()+1); }
  return n;
}

/* Códigos válidos na base têm 4 ou 5 dígitos. Fora disso são erros de digitação
   (normalmente código e quantidade trocados no formulário). */
const codigoValido = c => /^\d{4,5}$/.test(String(c==null?'':c).trim());

/* ===================== NORMALIZAÇÃO ===================== */
function tipoPadrao(v){
  const c = semAcento(v).replace(/\u00a0/g,' ').trim();
  if(c.includes('falta')) return 'Falta';
  if(c.includes('requisi')) return 'Requisição';
  if(c.includes('sobra')) return 'Sobras';
  return String(v||'').replace(/\u00a0/g,' ').trim() || 'Outros';
}
function limpaNum(v){
  const s = String(v==null?'':v).replace(/\u00a0/g,' ').trim().replace(/\./g,'').replace(',','.');
  if(!s) return null;
  const n = Number(s);
  return Number.isFinite(n) ? n : null;
}
const limpaTxt = v => String(v==null?'':v).replace(/\u00a0/g,' ').trim().replace(/\.0$/,'');

function preparar(lista){
  return lista.map(r=>{
    const d = paraData(r.d);
    return {d:limpaTxt(r.d), dt:d, mes:d?mesChave(d):'', dia:d?d.getDay():null,
            op:limpaTxt(r.op), c:limpaTxt(r.c), q:(r.q==null?null:Number(r.q)),
            t:tipoPadrao(r.t), l:limpaTxt(r.l), o:limpaTxt(r.o), s:limpaTxt(r.s)};
  }).filter(r=>r.dt || r.c || r.op);
}

/* ===================== LEITURA DE ARQUIVO ===================== */
function acharCampo(obj, termos){
  const chaves = Object.keys(obj);
  for(const t of termos){
    const k = chaves.find(x => semAcento(x).includes(semAcento(t)));
    if(k) return obj[k];
  }
  return '';
}
function mapearLinha(r){
  return {
    d: acharCampo(r,['hora de inicio','data']),
    op: acharCampo(r,['ordem de producao','op']),
    c: acharCampo(r,['codigo do componente','codigo']),
    q: limpaNum(acharCampo(r,['quantidade necessaria','quantidade'])),
    t: acharCampo(r,['falta ou requisicao','tipo']),
    l: acharCampo(r,['qual a linha','linha']),
    o: acharCampo(r,['observacao geral','observacao']),
    s: acharCampo(r,['status'])
  };
}
function lerCSV(texto){
  const limpo = texto.replace(/^\uFEFF/,'').replace(/\r\n/g,'\n').replace(/\r/g,'\n');
  const primeira = limpo.slice(0, limpo.indexOf('\n')>0?limpo.indexOf('\n'):200);
  const sep = (primeira.split(';').length >= primeira.split(',').length) ? ';' : ',';
  const linhas=[]; let campo='', linha=[], aspas=false;
  for(let i=0;i<limpo.length;i++){
    const ch = limpo[i];
    if(aspas){
      if(ch === '"'){ if(limpo[i+1] === '"'){campo+='"';i++;} else aspas=false; }
      else campo += ch;
    } else if(ch === '"') aspas = true;
    else if(ch === sep){ linha.push(campo); campo=''; }
    else if(ch === '\n'){ linha.push(campo); linhas.push(linha); linha=[]; campo=''; }
    else campo += ch;
  }
  if(campo!=='' || linha.length){ linha.push(campo); linhas.push(linha); }
  if(!linhas.length) return [];
  const cab = linhas.shift().map(x=>x.trim());
  return linhas.filter(l=>l.some(c=>String(c).trim()!=='')).map(l=>{
    const o={}; cab.forEach((c,i)=>o[c]=l[i]==null?'':l[i]); return o;
  });
}
function aplicarBase(brutos, nomeArquivo){
  const registros = preparar(brutos.map(mapearLinha));
  if(!registros.length) throw new Error('Nenhum registro válido encontrado. Confira se as colunas do arquivo seguem o padrão da base.');
  BASE = registros;
  $('nomeFonte').textContent = nomeArquivo;
  $('dataCarga').textContent = ' · carregada em ' + new Date().toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'});
  iniciarFiltros();
  mostrarAviso('ok', 'Base atualizada com sucesso: ' + num(registros.length) + ' registros carregados de "' + nomeArquivo + '".');
}
function mostrarAviso(tipo, texto){
